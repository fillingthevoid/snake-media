    {
      "id": "681c0d12-f842-432d-864b-ded59066594a",
      "name": "Validate Interpretation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1220,
        -100
      ],
      "parameters": {
        "jsCode": "\nconst data = $input.first().json;\nif (Object.prototype.hasOwnProperty.call(data, 'error')) return [{json: {route: 'error'}}];\nconst out = data.output;\nconst clarify = [{json: {route: 'clarification'}}];\nif (!out || !['movie', 'tv'].includes(out.type) || typeof out.title !== 'string' || !out.title.trim()) return clarify;\nif (out.title.length > 300) return clarify;\nconst result = {route: out.type, title: out.title.trim()};\nif (out.year !== undefined && out.year !== null) {\n  if (!Number.isInteger(out.year) || out.year < 1800 || out.year > 2200) return clarify;\n  result.year = out.year;\n}\nreturn [{json: result}];\n"
      }
    },
