              "type": "string",
              "value": "100000000000000001"
            },
            {
              "id": "88d0a926-e4c4-461c-a3e1-b2637427eb5a",
              "name": "allowedChannelIds",
              "type": "string",
              "value": "100000000000000004"
            }
