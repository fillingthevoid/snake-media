            "source": "={{ $json.source }}",
            "destinationId": "={{ $json.destinationId }}",
            "payloadJson": "={{ $json.payloadJson }}",
            "state": "={{ $json.state }}",
            "deliveredMessageId": "={{ $json.deliveredMessageId }}",
            "attempts": "={{ $json.attempts }}",
            "nextAttemptAt": "={{ $json.nextAttemptAt }}",
            "deliveredAt": "={{ $json.deliveredAt }}"
          },
          "schema": [
