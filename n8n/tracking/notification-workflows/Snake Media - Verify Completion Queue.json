    "Find Synthetic Notice": {
      "main": [
        [
          {
            "node": "Assert Notice Stored",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "executionTimeout": 240
  },
  "active": false
