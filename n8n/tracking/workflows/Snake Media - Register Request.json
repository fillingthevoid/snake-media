      ],
      "alwaysOutputData": true
    },
    {
      "id": "d1e9afab-44b4-5245-8847-0132943c5423",
      "name": "Resolve Existing",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const request = $('Normalize Request').first().json;\nconst rows = $input.all().map(x => x.json).filter(x => x.requestKey);\nif (rows.length > 1) throw new Error('Tracking conflict: duplicate request keys require reconciliation');\nif (rows.length === 1) {\n  const existing = rows[0];\n  // state can change later; repeat delivery must not revert it.\n  for (const key of Object.keys(request).filter(k => k !== 'state')) {\n    if (existing[key] !== request[key]) throw new Error('Tracking conflict: original request cannot be overwritten');\n  }\n  return [{json: {exists: true, record: existing}}];\n}\nreturn [{json: {exists: false, record: request}}];\n"
      },
      "position": [
        720,
        0
      ]
    },
