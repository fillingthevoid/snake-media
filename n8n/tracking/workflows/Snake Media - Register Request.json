      "typeVersion": 1.1,
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "snake_media_requests"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "requestKey",
              "condition": "eq",
              "keyValue": "={{ $json.requestKey }}"
            }
          ]
        },
        "returnAll": true
      },
