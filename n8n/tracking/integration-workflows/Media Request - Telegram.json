        "attributes": {
          "attributes": [
            {
              "name": "type",
              "description": "Classify the requested media as exactly one of: movie, tv, unknown. Use \"movie\" for films and \"tv\" for television/streaming series. Use \"unknown\" if the request is not for media or you cannot reliably determine whether the title is a movie or TV series. Never guess when genuinely ambiguous.",
              "required": true
            },
            {
              "name": "title",
              "description": "The canonical title of the movie or TV series being requested. Remove conversational command words such as add, download, grab, get, please, movie, show, series, and year phrases. Preserve the actual media title. If no media title can be identified, return an empty string.",
              "required": true
            },
            {
              "name": "year",
              "type": "number",
              "description": "The four-digit release or premiere year specified by the user. If the user does not specify a year, do not invent one."
            }
          ]
        },
        "options": {
          "systemPromptTemplate": "You extract movie and TV series requests for a personal media-management system.\n\nReturn only information supported by the user's request or reliably identifiable from the named media title.\n\nThe \"type\" field must be exactly:\n- movie\n- tv\n- unknown\n\nInterpret natural conversational commands such as \"add\", \"grab\", \"get\", \"download\", \"find\", or \"I want\" as media requests.\n\nDo not include command words in the title.\n\nIf a year is explicitly supplied, extract it. If no year is supplied, do not invent one.\n\nIf the message is not a recognizable request for a movie or TV series, set type to \"unknown\".\n\nWhen genuinely uncertain whether a title refers to a movie or TV series, set type to \"unknown\" rather than guessing."
        }
      },
