    },
    {
      "id": "033c6caf-b240-5fa0-b643-bda7f2196e71",
      "name": "Return Media Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const r=$('Normalize Media Metadata').first().json; const t=$input.first().json; const {raw,context,...result}=r; return [{json:{...result,trackingRegistered:!!t.requestKey}}];"
      },
      "position": [
        1800,
