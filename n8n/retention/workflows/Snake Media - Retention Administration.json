    {
      "id": "5596e50e-c47f-59ef-8bb4-b3a880031877",
      "name": "Validate Mode Change",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const rows=$input.all().filter(x=>x.json.key);if(rows.length!==1)throw new Error('Invalid control state');const action=$('Validate Admin Action').first().json.action;if(action!=='status'&&rows[0].json.owner!=='')throw new Error('Cannot change mode while retention is running');return [{json:{action}}];"
      },
      "position": [
        1620,
        0
      ]
    },
