          "id": "CONFIGURE_HTTPHEADERAUTH",
          "name": "Configure httpHeaderAuth"
        }
      },
      "notes": "Required: select a Header Auth credential. Name: X-Snake-Media-Key. Value: a private random shared secret. Never disable authentication."
    },
    {
      "id": "7dfcfd2e-18e1-539d-a8f9-8fa9f01349e9",
      "name": "Validate Admin Action",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const action=$json.body?.action;if(!['scan','enable','preview','status'].includes(action))throw new Error('Invalid retention action');return [{json:{action}}];"
      },
      "position": [
        270,
        0
      ]
    },
    {
      "id": "089b2059-48b5-5358-88f5-e20ed55865e1",
      "name": "Run Admin Scan?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "condition",
              "leftValue": "={{ $json.action==='scan' }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "position": [
        540,
        0
      ]
    },
    {
      "id": "8a207144-9618-5536-8f16-cf60c589ba7f",
      "name": "Admin Scan Job",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "return [{json:{job:'scan'}}];"
      },
      "position": [
        810,
        0
      ]
    },
    {
      "id": "bba30abd-4637-52e3-8c36-70d45950fc68",
