{
  "id": "snakeRetentionScheduleV1",
  "name": "Snake Media - Retention and Future Episodes",
  "nodes": [
    {
      "id": "764309d7-4df3-55da-8cf7-3a906a06d0f9",
      "name": "Every Fifteen Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "position": [
        0,
        0
      ]
    },
    {
      "id": "d90e286f-bb5a-5c48-b823-7888dd6b642c",
      "name": "Scan Job",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "return [{json:{job:'scan'}}];"
      },
      "position": [
        270,
        0
      ]
    },
    {
      "id": "49f08b81-0a4c-520f-bbaa-f6e22c5f1d67",
      "name": "Coordinate Retention Scan",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "snakeRetentionCoordinatorV1"
        },
        "workflowInputs": {
          "mappingMode": "passThrough"
        },
        "mode": "once",
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "position": [
        540,
        0
      ],
      "alwaysOutputData": true
    }
  ],
  "connections": {
    "Every Fifteen Minutes": {
      "main": [
        [
          {
            "node": "Scan Job",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Scan Job": {
      "main": [
        [
          {
            "node": "Coordinate Retention Scan",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "executionTimeout": 600
  }
}
