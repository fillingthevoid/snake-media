      "name": "Check Deletion Owner",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const d=$('Deletion Input').first().json;const locks=$input.all().filter(x=>x.json.key);if(locks.length!==1||!d.owner||locks[0].json.owner!==d.owner||d.due!==true||Date.parse(d.expiresAt)>Date.now())throw new Error('Deletion lock or deadline invalid');return [{json:d}];"
