    {
      "id": "e1cc4470-2c1a-547b-b4e2-1e94a3c94d82",
      "name": "Verify Unmonitor And Coverage",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const d=$('Deletion Input').first().json;const rows=$input.all().map(x=>x.json);if(d.mediaType==='movie'){if(rows.length!==1||rows[0].monitored!==false||rows[0].movieFile?.id!==d.fileId||rows[0].movieFile?.path!==d.path)throw new Error('Movie verification failed');}else{const covered=rows.filter(e=>e.episodeFileId===d.fileId);if(covered.length!==d.episodeIds.length||covered.some(e=>e.monitored!==false||!d.episodeIds.includes(String(e.id))||e.episodeFile?.path!==d.path))throw new Error('Episode verification failed');}return [{json:d}];"
      },
      "position": [
        810,
        480
      ]
