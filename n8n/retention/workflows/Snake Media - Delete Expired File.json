      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const d=$('Deletion Input').first().json;const f=$json;if(f.id!==d.fileId||f.path!==d.path||Date.parse(f.dateAdded)!==Date.parse(d.importedAt))throw new Error('File changed after retention snapshot');return [{json:{owner:d.owner,key:d.key,kind:'file',payloadJson:JSON.stringify({...d,state:'deleting'})}}];"
      },
