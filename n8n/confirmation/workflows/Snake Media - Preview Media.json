      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const rows=$input.all().filter(x=>x.json.id);if(rows.length>1)throw new Error('Duplicate preview');return [{json:{existing:rows.length===1,record:rows[0]?.json||$('Select Preview').first().json}}];"
