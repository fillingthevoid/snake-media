    {
      "id": "2914a7cf-f951-5c33-b2cc-747fa37846a1",
      "name": "Select Preview",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const i=$('Preview Input').first().json;const m=$input.all().map(x=>x.json).find(x=>Number.isSafeInteger(x[i.mediaType==='movie'?'tmdbId':'tvdbId'])&&(!i.year||x.year===i.year));if(!m)return [{json:{version:1,status:'not_found'}}];const c=i.context;return [{json:{source:c.source,userId:c.userId,destinationId:c.destinationId,requestKey:[c.source,c.destinationId,c.messageId].join(':'),contextJson:JSON.stringify(c),mediaType:i.mediaType,mediaJson:JSON.stringify(m),state:'preview',claimId:'',choice:'',expiresAt:new Date(Date.now()+30*60000).toISOString()}}];"
      },
      "position": [
        1500,
        0
      ]
    },
