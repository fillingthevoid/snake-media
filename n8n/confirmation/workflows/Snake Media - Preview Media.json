    {
      "id": "b1100cab-02f6-5d5d-9a8f-25485b34b1ef",
      "name": "Validate Preview",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const i=$('Preview Input').first().json,c=i.context;if(!['movie','tv'].includes(i.mediaType)||typeof i.title!=='string'||!i.title.trim()||!c||!['discord','telegram'].includes(c.source)||!/^[-]?[1-9][0-9]*$/.test(c.destinationId)||!/^[0-9]+$/.test(c.userId)||!/^[0-9]+$/.test(c.messageId)||!Number.isFinite(Date.parse(c.requestedAt)))throw new Error('Invalid preview context');return [{json:i}];"
      },
      "position": [
        500,
        0
      ]
    },
