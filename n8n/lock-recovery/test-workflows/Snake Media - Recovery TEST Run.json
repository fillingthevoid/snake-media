      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const rows=$input.all().map(x=>x.json);if(!rows.some(r=>r.key==='global'&&r.owner==='')||!rows.some(r=>r.key==='mode'&&r.owner==='preview')||!rows.some(r=>r.key==='recovery'&&JSON.parse(r.owner).owner==='123'))throw Error('Incomplete recovery');return [{json:{body:{...$('Valid Recovery Proof').first().json.body,checkedAt:new Date().toISOString()}}}];"
      },
