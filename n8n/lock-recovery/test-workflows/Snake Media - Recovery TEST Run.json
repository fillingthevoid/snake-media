      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const rows=$input.all().map(x=>x.json);if(!rows.some(r=>r.key==='global'&&r.owner==='123')||!rows.some(r=>r.key==='mode'&&r.owner==='enabled'))throw Error('Wrong owner mutated state');return [{json:{body:{owner:'123',workflowId:'snakeRetentionCoordinatorV1',status:'error',stoppedAt:new Date(Date.now()-300000).toISOString(),checkedAt:new Date().toISOString(),activeExecutions:0}}}];"
