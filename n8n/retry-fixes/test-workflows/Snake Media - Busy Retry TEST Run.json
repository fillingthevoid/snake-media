      "typeVersion": 1.3,
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "snakeBusyRetryTestChild"
        },
        "workflowInputs": {
          "mappingMode": "passThrough"
        },
        "mode": "once",
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "position": [
        540,
        250
      ],
      "alwaysOutputData": true
    },
    {
      "id": "486037bd-0c85-539d-97a9-514475ce1725",
      "name": "Assert Retried Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "if($json.actionAccepted!==true||$json.busy===true)throw Error('Retry failed');return [{json:{passed:true,kind:$('Retry Test Webhook').first().json.body.kind}}];"
      },
      "position": [
        810,
        250
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
