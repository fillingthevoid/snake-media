      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "snakeBusyRetryTestChild"
        },
        "workflowInputs": {
          "mappingMode": "passThrough"
        },
        "mode": "once",
        "options": {
          "waitForSubWorkflow": true
