    {
      "id": "23f2b700-0cdc-536f-8237-0108f4bcb5b9",
      "name": "Retry Fixture",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const b=$('Retry Test Webhook').first().json.body;if(!['preview','scope','seasons','retention'].includes(b.kind))throw Error('Unknown fixture');return [{json:{source:'discord',userId:'2',destinationId:'3',requestKey:'retry:'+b.kind,contextJson:JSON.stringify(b.kind==='retention'?{retentionChange:{operation:'extend',days:7,title:'SYNTHETIC'}}:{}),mediaType:b.kind==='preview'?'movie':'tv',mediaJson:'{}',state:b.kind==='retention'?'preview':b.kind,claimId:'original',choice:'choose',expiresAt:new Date(Date.now()+600000).toISOString()}}];"
      },
      "position": [
        540,
        0
      ]
    },
    {
      "id": "seed-retry",
      "name": "Seed Retry Fixture",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "parameters": {
        "resource": "row",
        "operation": "upsert",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "retrycheck_choices"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "requestKey",
              "condition": "eq",
              "keyValue": "={{ $json.requestKey }}"
            }
          ]
        },
        "options": {},
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "source": "={{ $json.source }}",
            "userId": "={{ $json.userId }}",
            "destinationId": "={{ $json.destinationId }}",
            "requestKey": "={{ $json.requestKey }}",
            "contextJson": "={{ $json.contextJson }}",
            "mediaType": "={{ $json.mediaType }}",
            "mediaJson": "={{ $json.mediaJson }}",
            "state": "={{ $json.state }}",
