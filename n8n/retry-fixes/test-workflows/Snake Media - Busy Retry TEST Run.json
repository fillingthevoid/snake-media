    {
      "id": "e338768a-c7bd-5bbc-860d-3fb5e7d90841",
      "name": "Retry Test Actor",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const initial=$('Seed Retry Fixture').first().json;if($json.state!==initial.state||$json.claimId!==initial.claimId||$json.choice!==initial.choice)throw Error('Original selection not restored');return [{json:{...$('Busy Test Actor').first().json,simulateBusy:false}}];"
      },
      "position": [
        270,
        250
      ]
    },
    {
      "id": "b950b037-75df-56b6-9bea-35ac57f59eb8",
