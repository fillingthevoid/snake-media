    {
      "id": "b4cc0264-6f33-5533-b828-33a234a156e0",
      "name": "Assert Busy Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "if($json.busy!==true||$json.actionAccepted!==false)throw Error('Busy must be retryable');return [{json:{}}];"
      },
      "position": [
        1620,
        0
      ]
    },
    {
