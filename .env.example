# Copy to your private .env; fill in locally. Never share your token.
APPDATA_DIR=./data
ADMIN_RUNTIME_DIR=./admin-runtime
DISCORD_TOKEN=
# Comma-separated immutable IDs; no trailing commas.
ALLOWED_DISCORD_USER_IDS=
# Exact permitted text channel IDs. DMs are always ignored.
ALLOWED_DISCORD_CHANNEL_IDS=
# Keep test mode until the new n8n webhook is configured and validated.
BOT_MODE=test
# Required only for BOT_MODE=n8n. Never point at the Telegram trigger.
# Example shape: http://192.168.1.10:5678/webhook/your-new-discord-workflow
N8N_WEBHOOK_URL=
# Shared with n8n Header Auth: header name X-Snake-Media-Key.
N8N_WEBHOOK_SECRET=
N8N_TIMEOUT_SECONDS=60

# Optional: enable after publishing the authenticated notification queue workflow.
N8N_NOTIFICATIONS_URL=
# Local (non-Docker) runs can override this. Compose uses its /state bind mount.
NOTIFICATION_STATE_PATH=/state/notifications.sqlite3
# Owner-only administration. Requires the host Unix-socket helper and n8n endpoint.
ADMIN_DISCORD_USER_IDS=
# Optional independent host monitor; must be one of the admin IDs above.
ALERT_OWNER_DISCORD_USER_ID=
# Leave these blank until the optional host helper is installed.
ADMIN_SOCKET_PATH=
AUTHORIZATION_STATE_PATH=

# Used when generating n8n presentation workflows on snake.
# Example remote base: http://<snake-tailscale-ip>:8096
JELLYFIN_PUBLIC_URL=
# Optional home-network link displayed alongside the remote link.
JELLYFIN_LOCAL_URL=
